# =========================================================
# Jack — Variables de entorno
# Copiar este archivo a .env.local y completar los valores reales.
# NUNCA commitear .env.local (ya está en .gitignore).
#
# Regla de prefijos:
#   VITE_*  → quedan embebidas en el bundle del cliente (build).
#   resto   → secretos de servidor, se setean como secrets/variables
#             de entorno del runtime (dev .env.local / prod Cloudflare).
# =========================================================

# --- Supabase (obligatorio) ---
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...  # public anon key del proyecto
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...  # service_role: SOLO server, nunca al bundle
SUPABASE_DB_URL=postgresql://postgres:<pass>@db.<tu-proyecto>.supabase.co:5432/postgres  # opcional, tooling

# --- Google OAuth (login) ---
# OAuth Client ID tipo "Web application" configurado como provider de Google
# en Supabase Auth. El secret solo lo usa la CLI de Supabase para levantar
# Auth local (supabase/config.toml), no la app.
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# --- Google OAuth (Gmail, app propia) ---
# Segundo OAuth Client ID "Web application" con el scope Gmail.send.
# Los secretos de este cliente los lee SOLO el server (src/lib/server/).
GOOGLE_CLIENT_ID=<client-id-gmail>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/gmail-callback
# Clave simétrica para cifrar refresh tokens de Gmail en DB (server).
# OBLIGATORIA (generar con `openssl rand -base64 32`). Si falta, el server
# falla fuerte; no cae a SUPABASE_SERVICE_ROLE_KEY.
OAUTH_ENCRYPTION_KEY=<32+ caracteres aleatorios>

# --- Proveedor de IA (server-side) ---
AI_PROVIDER=gemini   # gemini | anthropic
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...

# --- Mocks para E2E / dev sin servicios externos (opcional) ---
# Con "true" la extracción de avisos y el envío por Gmail se simulan del lado
# del server; el resto (DB, Storage, RPC) sigue siendo real.
MOCK_AI=false
MOCK_GMAIL=false

# --- Observabilidad (opcional; sin ellas la app corre igual) ---
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# VITE_POSTHOG_KEY=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com