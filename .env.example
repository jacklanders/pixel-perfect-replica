# Copiar a .env.local (git-ignorado) y completar con valores reales.
# Nunca commitear valores reales. Este archivo solo documenta nombres de variables.

# --- Supabase (frontend, seguro de exponer: son claves públicas ancladas por RLS) ---
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=ficticio-anon-key

# --- Supabase (solo servidor / CI — NUNCA con prefijo VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=ficticio-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:54322/postgres

# --- Proveedor de IA (server functions únicamente, nunca en el navegador) ---
AI_PROVIDER=gemini
ANTHROPIC_API_KEY=ficticio-anthropic-key
GEMINI_API_KEY=ficticio-gemini-key
GLOBAL_AI_BUDGET_USD_MONTHLY=20

# --- Google OAuth (login con Google vía Supabase Auth, Hito 1) ---
# Mismo Client ID/Secret de Google Cloud que se usa después en Hito 4 para
# gmail.send — acá solo se piden los scopes básicos de identidad (openid email
# profile), el scope gmail.send se pide aparte, incremental, recién en Hito 4.
# Si usás Supabase LOCAL (Docker), este mismo par también va en
# supabase/config.toml -> [auth.external.google] (leído como env(...) por la CLI).
# Si usás Supabase CLOUD, se configura en el Dashboard -> Authentication -> Providers -> Google,
# no acá — pero igual documentá el valor real acá para tenerlo a mano.
GOOGLE_OAUTH_CLIENT_ID=ficticio.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=ficticio-client-secret
# Solo se usa en Hito 4 (Gmail send incremental), no en el login del Hito 1.
GOOGLE_OAUTH_REDIRECT_URI=https://tu-dominio/auth/gmail/callback

# --- Resend (emails del sistema, no simula envío desde Gmail del usuario) ---
RESEND_API_KEY=ficticio-resend-key
RESEND_FROM_EMAIL=notificaciones@tu-dominio

# --- Sentry ---
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- PostHog ---
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# --- Límites de negocio (no secretos, pero centralizados acá para dev local) ---
DAILY_FREE_APPLICATION_LIMIT=2
ADMIN_DAILY_APPLICATION_LIMIT=10
MAX_UPLOAD_SIZE_MB=10
